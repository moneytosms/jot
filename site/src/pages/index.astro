---
import Landing from "../layouts/Landing.astro";
import YearChart from "../components/YearChart.astro";
import DayDesk from "../components/DayDesk.astro";
import FrameViewer from "../components/FrameViewer.astro";
import { cfg, withBase } from "../lib/source";
import { demo, byDate, rawOf, parseDate } from "../lib/journal";
// Real `jot search parser` output on the sample journal, captured for the launch video.
import search from "../data/sauce-search.txt?raw";
import "../styles/fonts.css";
import "../styles/theme.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const today = byDate.get(demo.today);
const raw = today ? rawOf(today.entries) : "";
const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const specimen = raw.split("\n").map((line) =>
  line.startsWith("## ")
    ? `<span class="stamp">${escape(line)}</span>`
    : escape(line),
).join("\n");
const todayLabel = `${today?.weekday}, ${parseDate(demo.today).toLocaleDateString("en-GB", { day: "numeric", month: "long", timeZone: "UTC" })}`;
const install = "curl -fsSL https://raw.githubusercontent.com/moneytosms/jot/main/install-release.sh | sh";
const year = demo.today.slice(0, 4);

// The parody notes app. Invented name, no real product.
const modals = [
  { x: 4, y: 6, w: 70, r: -2, h: "Welcome to your second brain™", p: "Let's set up your workspace. This takes 4 minutes.", b: ["Get started"] },
  { x: 30, y: 16, w: 64, r: 3, h: "Choose a template", p: "1 of 214", b: [] },
  { x: 2, y: 30, w: 72, r: -4, h: "Invite your team to start writing", p: "Notes are better with 12 people watching.", b: ["Invite", "Skip for now"] },
  { x: 24, y: 42, w: 72, r: 2, h: "Enable AI to summarize your 1 note?", p: "Your note is empty. We can still summarize it.", b: ["Enable", "Enable"] },
  { x: 8, y: 56, w: 58, r: 5, h: "Syncing… 3%", p: "Please don't close this tab.", b: [] },
  { x: 34, y: 62, w: 62, r: -3, h: "Your session expired", p: "Log in again to keep thinking.", b: ["Log in"] },
  { x: 6, y: 72, w: 86, r: 1, h: "Upgrade to PRO MAX to use the keyboard", p: "Typing is a premium feature. $14/mo, billed yearly.", b: ["Upgrade"] },
];
const adds: [string, string][] = [
  ['jot add -j ideas "rewrite it in rust"', "ideas"],
  ['jot add "the bug was a missing semicolon. 4 hours."', "default"],
  ['jot add -j work "standup: blocked by vibes"', "work"],
  ['jot add "how do i exit vim (asking for a friend)"', "default"],
  ['jot add "remember to remember the thing"', "default"],
];
const matches = search.trimEnd().split("\n");
const total = matches.pop() ?? "";
// [left %, width %, length %] over the search results only, so the adds and :q lines stay readable.
const drips = [[4, 3, 46], [13, 2, 78], [21, 4, 34], [33, 2, 92], [46, 3, 58], [57, 2, 84], [68, 4, 40], [80, 2, 70], [90, 3, 52]];
---

<Landing
  title={`${cfg.name}: a plaintext journal you can read with cat`}
  description={cfg.description}
>
  <header class="masthead">
    <div class="wrap masthead__in">
      <a class="mark" href={base + "/"} aria-label="jot, top of page">jot</a>
      <p class="masthead__tag">a plaintext journal</p>
      <nav class="masthead__nav" aria-label="Page and project">
        <a class="masthead__sec" href="#year"><i>01</i>Year</a>
        <a class="masthead__sec" href="#day"><i>02</i>The day</a>
        <a class="masthead__sec" href="#tool"><i>03</i>Interface</a>
        <a class="masthead__sec" href="#tour"><i>04</i>Tour</a>
        <a href={withBase("guide/")}>Guide</a>
        <a href={cfg.repoUrl}>Source</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero wrap" aria-labelledby="hero-title" data-play>
      <h1 id="hero-title" aria-label="Your daybook, in plain text.">
        Your <s class="strike">notes app<span class="pen pen--above pop" style="--i:2">(it wanted a workspace)</span></s><br />
        <mark class="hl">daybook</mark>, in <em>plain text.</em>
      </h1>
      <div class="hero__text">
        <p class="lede">
          One Markdown file per day. No account, no sync, no AI summary of your grocery list.
          <code>jot</code> appends a timestamped entry to today's file and gets out of the way. Read it
          with <code>cat</code>, search it with <code>grep</code>, browse it in the calendar.
        </p>
        <p class="pen pen--note pop" style="--i:3">↑ we checked. it's just files.</p>
        <div class="install">
          <div class="install__line">
            <span class="install__ps" aria-hidden="true">$</span>
            <code>{install}</code>
          </div>
          <button class="install__copy" type="button" data-copy={install} aria-label="Copy the install command">Copy</button>
        </div>
        <p class="install__note">
          One small program, verified before it installs. No setup wizard, no "what brings you
          here today?". <a href={`${cfg.repoUrl}#install`}>Other ways to install</a>.
        </p>
      </div>

      <figure class="leaf">
        <p class="leaf__date">{todayLabel}</p>
        <pre class="leaf__body" aria-label="Contents of today's journal file" set:html={specimen} />
        <figcaption class="leaf__cap">
          <code>~/.jot/default/{demo.today}.md</code>
          <span>{today?.entries.length ?? 0} entries · {today?.bytes ?? 0} bytes</span>
        </figcaption>
        <p class="pen pen--leaf pop" style="--i:4" aria-hidden="true">← the entire database</p>
      </figure>
    </section>

    <section class="roast wrap" aria-labelledby="roast-title" data-play>
      <div class="roast__text">
        <p class="kicker"><span class="kicker__sq" aria-hidden="true"></span>A short tragedy</p>
        <h2 id="roast-title">You wanted to write down <em>one thought.</em></h2>
        <p class="roast__note">The notes app had other plans.</p>
      </div>

      <div class="stage" role="img" aria-label="A parody notes app, NOTESPACE PRO MAX, burying one thought under seven onboarding dialogs">
        <p class="stage__logo" aria-hidden="true">NOTESPACE PRO MAX</p>
        {modals.map((m, i) => (
          <div class="modal pop" aria-hidden="true" style={`--i:${i};--r:${m.r}deg;left:${m.x}%;top:${m.y}%;width:${m.w}%`}>
            <p class="modal__h">{m.h}</p>
            <p class="modal__p">{m.p}</p>
            {m.b.length > 0 && <p class="modal__b">{m.b.map((b) => <span>{b}</span>)}</p>}
          </div>
        ))}
        <p class="stage__no pen pop" aria-hidden="true" style="--i:7.6">no.</p>
      </div>

      <div class="roast__answer pop" style="--i:8.6">
        <p class="roast__claim">real developers use the terminal. <span class="pen">(allegedly)</span></p>
        <div class="term term--small">
          <p><span class="term__ps">❯</span> jot add "rename the variable back to what it was"</p>
          <p class="term__out">added to <span>default/{demo.today}.md</span></p>
        </div>
        <ul class="nots" aria-label="What it skipped">
          <li><s>account</s></li><li><s>sync</s></li><li><s>onboarding</s></li><li><s>AI</s></li>
        </ul>
        <p class="pen pen--that">that's it. that's the app.</p>
      </div>
    </section>

    <div class="wrap">
      <div class="claims">
        <div class="claim">
          <p class="claim__n">01</p>
          <p class="claim__t">Append-only</p>
          <p class="claim__p">Every entry gets a timestamp. Nothing you wrote is ever rewritten, even the embarrassing ones.</p>
        </div>
        <div class="claim">
          <p class="claim__n">02</p>
          <p class="claim__t">Private by default</p>
          <p class="claim__p">Your journal is readable by you and nobody else. No account, no sync, no "we've updated our privacy policy".</p>
        </div>
        <div class="claim">
          <p class="claim__n">03</p>
          <p class="claim__t">Nothing to run</p>
          <p class="claim__p">Back up a directory, delete the binary, keep the journal. It opens without jot. We'd be hurt, but it opens.</p>
        </div>
      </div>
    </div>

    <section class="band" id="year">
      <div class="wrap">
        <header class="sec">
          <p class="sec__no">01</p>
          <div>
            <h2>A year, one square at a time.</h2>
            <p class="sec__note">
              The calendar in the terminal is a grid of files, so the same grid works here.
              Shade is the number of entries written that day; empty days stay visible,
              because a gap is part of the record too.
            </p>
            <p class="pen pen--sec">no streaks. no guilt. no push notifications.</p>
          </div>
        </header>
        <YearChart />
      </div>
    </section>

    <section class="band" id="day">
      <div class="wrap">
        <header class="sec">
          <p class="sec__no">02</p>
          <div>
            <h2>The day, set to read.</h2>
            <p class="sec__note">
              Ten days from the sample journal. Switch between the typeset entries and the
              raw file they came from; the timestamps are the file's own.
            </p>
          </div>
        </header>
        <DayDesk />
      </div>
    </section>

    <section class="band band--sauce" id="sauce" aria-labelledby="sauce-title" data-play>
      <div class="wrap">
        <header class="sec">
          <p class="sec__no">02½</p>
          <div>
            <p class="sec__kick">Six months later</p>
            <h2 id="sauce-title">You are <em class="sauce-em">lost in the sauce.</em></h2>
            <p class="sec__note">
              Adding is one command. That is the problem. Below is the real
              <code>jot search parser</code> on the sample journal.
            </p>
          </div>
        </header>
        <div class="term term--sauce">
          <div class="term__bar"><span>~/journals</span><span>zsh</span></div>
          <div class="term__body">
            {adds.map(([cmd, j]) => (
              <>
                <p><span class="term__ps">❯</span> {cmd}</p>
                <p class="term__out">added to <span>{j}/{demo.today}.md</span></p>
              </>
            ))}
            <p><span class="term__ps">❯</span> jot search parser</p>
            <div class="pit">
              <div class="term__scroll">
                <pre class="term__fall">{matches.join("\n")}</pre>
              </div>
              <div class="drips" aria-hidden="true">
                {drips.map(([x, w, h], i) => <i style={`--x:${x}%;--w:${w}%;--h:${h}%;--d:${i % 4}`} />)}
              </div>
            </div>
            <p class="term__sum pop" style="--i:9.5">{total}</p>
            {[":q", ":wq", ":q!"].map((c, i) => (
              <div class="pop" style={`--i:${11 + i * 1.2}`}>
                <p><span class="term__ps">❯</span> {c}</p>
                <p class="term__err">zsh: command not found: {c}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="tool">
      <div class="wrap">
        <header class="sec">
          <p class="sec__no">03</p>
          <div>
            <h2>Okay. <em>One more command.</em></h2>
            <p class="sec__note">
              <code>jot tui</code>: a month of days with entry heat, the journals, and the selected
              day rendered as Markdown. Fuzzy search (typos welcome), todos and the key reference
              open over the same frame.
            </p>
            <p class="pen pen--sec">it quits with q. no vim required.</p>
          </div>
        </header>
        <FrameViewer />
      </div>
    </section>

    <section class="band" id="tour">
      <div class="wrap">
        <header class="sec">
          <p class="sec__no">04</p>
          <div>
            <h2>Forty seconds of jot.</h2>
            <p class="sec__note">
              One notes app, roasted. Then quick adds from the CLI, the calendar, fuzzy search and
              the year heatmap in the TUI. Every line of terminal output is the real binary on the
              sample journal.
            </p>
          </div>
        </header>
        <figure class="film">
          <video controls preload="none" poster={`${withBase("clips/launch.jpg")}`} aria-label="A forty second tour of jot: quick adds from the CLI, then the calendar, fuzzy search and year heatmap in the TUI">
            <source src={`${withBase("clips/launch.mp4")}`} type="video/mp4" />
            Your browser cannot play this video. <a href={`${withBase("clips/launch.mp4")}`}>Download it</a>.
          </video>
          <figcaption class="film__cap">
            <span>40s · real output on the sample journal</span>
            <span class="film__tag">demo</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="band" id="record">
      <div class="wrap">
        <header class="sec">
          <p class="sec__no">05</p>
          <div>
            <h2>What it does not do.</h2>
            <p class="sec__note">
              The scope is the feature. jot is for one person's days on one machine, in files
              that outlive the program.
            </p>
          </div>
        </header>
        <div class="record">
          <div class="record__col">
            <h3>One directory</h3>
            <pre>~/.jot/
├── config.json
├── default/
│   ├── 2026-11-25.md
│   └── 2026-11-24.md
└── work/
    └── 2026-11-19.md</pre>
            <p>Journals are sibling directories. There is no index to rebuild.</p>
          </div>
          <div class="record__col">
            <h3>No server, no account</h3>
            <p>
              Nothing is uploaded and nothing is fetched to read your journal. Sync it with
              whatever you already use, or don't; jot will not notice either way.
            </p>
            <p>Nothing runs in the background. When you close it, it's closed.</p>
          </div>
          <div class="record__col">
            <h3>Read-mostly by design</h3>
            <p>
              The TUI can add a quick line, but edits, deletions and checkbox changes happen in
              your editor. Yes, even that editor. One writer, no merge rules, no surprises.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="closing wrap" aria-labelledby="closing-title">
      <p class="closing__kicker">Documentation</p>
      <a class="closing__link" href={withBase("guide/")} id="closing-title">
        Read the guide<span aria-hidden="true">→</span>
      </a>
      <p class="closing__note">
        Commands, configuration, themes, the storage format and the TUI keys, rendered from the
        repository's own Markdown and searchable in the browser. A manual. Remember those?
      </p>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__grid">
      <div>
        <p class="foot__mark">jot</p>
        <p>0.5.0 · free and open source</p>
      </div>
      <nav class="foot__links" aria-label="Project">
        <a href={withBase("guide/")}>Guide</a>
        <a href={cfg.repoUrl}>Source</a>
        <a href={`${cfg.repoUrl}/releases`}>Releases</a>
        <a href={`${cfg.repoUrl}/issues`}>Issues</a>
      </nav>
      <p class="foot__note">
        Everything on this page is a sample journal, shown with the real jot. {year}.
      </p>
    </div>
    <p class="wrap foot__wq" aria-hidden="true">:wq</p>
  </footer>

  <script>
    const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
    copy?.addEventListener("click", async () => {
      const text = copy.dataset.copy ?? "";
      const label = copy.textContent;
      try {
        await navigator.clipboard.writeText(text);
        copy.textContent = "Copied";
      } catch {
        copy.textContent = "Select and copy";
      }
      window.setTimeout(() => { copy.textContent = label; }, 1800);
    });

    // Gags play once, when their section comes into view.
    const io = new IntersectionObserver((seen) => {
      for (const s of seen) {
        if (!s.isIntersecting) continue;
        s.target.classList.add("is-on");
        io.unobserve(s.target);
      }
    }, { threshold: 0.2 });
    document.querySelectorAll("[data-play]").forEach((el) => io.observe(el));
  </script>
</Landing>

<style is:global>
  html { scroll-padding-top: 84px; }
  main { display: block; }
</style>

<style>
  .wrap {
    width: 100%;
    max-width: calc(var(--wide) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Running head */
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }
  .masthead__in {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 11px 10px;
  }
  .mark {
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.035em;
    text-decoration: none;
    color: var(--ink);
  }
  .mark:hover { color: var(--forest); }
  .masthead__tag {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .masthead__nav {
    margin-left: auto;
    display: flex;
    align-items: baseline;
    gap: clamp(10px, 1.7vw, 24px);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .masthead__nav a {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .masthead__nav a:hover { color: var(--forest); text-decoration: underline; text-underline-offset: 4px; }
  .masthead__nav i { font-style: normal; color: var(--ink-4); margin-right: 0.5em; }

  /* Opening */
  .kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 clamp(20px, 3.6vw, 38px);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .kicker__sq { width: 7px; height: 7px; background: var(--forest); flex: none; }
  .lede {
    margin: clamp(20px, 3vw, 30px) 0 0;
    max-width: 47ch;
    font-size: clamp(1.02rem, 1.4vw, 1.12rem);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .lede code,
  .install__note code,
  .claim__p code {
    font-size: 0.84em;
    color: var(--ink);
    background: var(--paper-deep);
    padding: 0.05em 0.28em;
    border-radius: 1px;
  }

  .install {
    display: flex;
    align-items: stretch;
    margin-top: clamp(24px, 3.4vw, 34px);
    border: 1px solid var(--ink);
    background: var(--paper-raised);
  }
  .install__line {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 11px 13px;
  }
  .install__ps { font-family: var(--mono); font-size: 0.78rem; line-height: 1.65; color: var(--forest); }
  .install code {
    font-family: var(--mono);
    font-size: clamp(0.62rem, 1.1vw, 0.74rem);
    line-height: 1.65;
    overflow-wrap: anywhere;
    color: var(--ink);
  }
  .install__copy {
    flex: none;
    appearance: none;
    border: 0;
    border-left: 1px solid var(--ink);
    background: transparent;
    padding: 0 15px;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    cursor: pointer;
  }
  .install__copy:hover { background: var(--ink); color: var(--paper); }
  .install__note {
    margin-top: 9px;
    font-size: 0.83rem;
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 55ch;
  }
  .install__note a { color: var(--ink-2); }

  /* Opening: a serious daybook page, marked up by an editor */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(28px, 4vw, 44px) clamp(32px, 6vw, 86px);
    align-items: start;
    padding-block: clamp(76px, 10vw, 132px) clamp(48px, 6vw, 76px);
  }
  .hero h1 {
    grid-column: 1 / -1;
    font-size: clamp(3rem, 8.4vw, 7.2rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 500;
  }
  .hero h1 em { font-style: italic; color: var(--forest); }
  .strike { position: relative; text-decoration: none; white-space: nowrap; }
  .strike::after {
    content: "";
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    top: 54%;
    height: 0.075em;
    border-radius: 2px;
    background: var(--pen);
    transform: rotate(-3deg);
    transform-origin: left;
  }
  .hl {
    color: inherit;
    background: linear-gradient(transparent 58%, var(--hi) 58%, var(--hi) 92%, transparent 92%) no-repeat;
    background-size: 100% 100%;
  }
  .pen {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.2;
    color: var(--pen);
  }
  .pen--above {
    position: absolute;
    left: 28%;
    bottom: 86%;
    font-size: max(0.26em, 1rem);
    white-space: nowrap;
    rotate: -4deg;
  }
  .pen--note,
  .pen--sec,
  .pen--that { display: inline-block; rotate: -2deg; transform-origin: left; }
  .pen--note { margin: 12px 0 0 2px; font-size: clamp(1.1rem, 1.7vw, 1.4rem); }
  .pen--sec { margin-top: 12px; font-size: clamp(1.1rem, 1.8vw, 1.35rem); }

  .leaf {
    position: relative;
    margin: 6px 0 0;
    padding: 24px 26px 16px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    box-shadow: 8px 8px 0 var(--paper-deep);
    rotate: 1.4deg;
  }
  .leaf__date { margin: 0 0 12px; font-size: 1.6rem; line-height: 1.1; font-weight: 500; letter-spacing: -0.015em; }
  .leaf__body {
    margin: 0;
    font-size: clamp(0.72rem, 1.05vw, 0.82rem);
    line-height: 1.8;
    color: var(--ink-2);
    white-space: pre-wrap;
  }
  .leaf__body :global(.stamp) { color: var(--forest); }
  .leaf__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 14px;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dashed var(--rule);
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--ink-3);
  }
  .leaf__cap code { font-size: inherit; color: var(--ink-2); }
  .pen--leaf { position: absolute; right: 8px; bottom: -2.1em; margin: 0; font-size: 1.2rem; rotate: -3deg; }

