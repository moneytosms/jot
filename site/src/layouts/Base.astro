---
import "../styles/fonts.css";
import "../styles/theme.css";
import "../styles/global.css";
import { cfg, REPO } from "../lib/source";

interface Props {
  title: string;
  description: string;
  active?: "home" | "guide";
}
const { title, description, active = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f3efe4" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="head">
      <div class="head__in">
        <a class="brand" href={base + "/"} aria-label="jot home">
          <span class="brand__mark">jot</span>
          <span class="brand__sub">a plaintext journal</span>
        </a>
        <nav aria-label="Primary">
          <a href={base + "/"} aria-current={active === "home" ? "page" : undefined}>Overview</a>
          <a href={`${base}/guide/`} aria-current={active === "guide" ? "page" : undefined}>Guide</a>
          <a href={REPO} rel="noopener">Source</a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>{cfg.footnote || cfg.tagline}</p>
        <p class="site-footer__links">
          <a href={`${base}/guide/`}>Guide</a>
          <a href={REPO}>Source</a>
          <a href={`${REPO}/releases`}>Releases</a>
        </p>
      </div>
    </footer>
  </body>
</html>
