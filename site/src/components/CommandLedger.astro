---
import { demo } from "../lib/journal";
const runs = demo.transcript;
---

<div class="ledger">
  {runs.map((run) => (
    <div class="tr">
      <p class="tr__cmd"><span aria-hidden="true">$</span> <code>{run.cmd}</code></p>
      <pre class="tr__out" aria-label={`output of ${run.cmd}`}>{run.out}</pre>
    </div>
  ))}
</div>

<style>
  .ledger { border-top: 1px solid var(--ink); }
  .tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
    padding: 15px 0 17px;
    border-bottom: 1px solid var(--rule);
  }
  .tr__cmd {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink);
  }
  .tr__cmd span { color: var(--forest); }
  .tr__cmd code { font-size: inherit; }
  .tr__out {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--ink-3);
    white-space: pre;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  @media (min-width: 880px) {
    .tr { grid-template-columns: 300px minmax(0, 1fr); gap: 28px; align-items: start; }
    .tr__cmd { padding-top: 1px; }
  }
</style>
